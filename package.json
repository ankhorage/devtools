{
  "name": "@ankhorage/devtools",
  "version": "2.2.0",
  "description": "Shared tooling, repository automation, and agent standards for Ankhorage TypeScript projects",
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/devtools#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/devtools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/devtools.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "ankh": {
    "category": "devtools",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "devtools.apm.sync",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Sync APM release",
        "description": "Bind owner metadata to the Changesets release version."
      },
      {
        "id": "devtools.apm.validate",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Validate APM release",
        "description": "Validate the exact packed APM release artifact."
      },
      {
        "id": "devtools.structure.build",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Build structure evidence",
        "description": "Generate deterministic structural descriptor evidence."
      },
      {
        "id": "devtools.structure.check",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Check structure evidence",
        "description": "Verify structural descriptor evidence is current."
      },
      {
        "id": "devtools.changeset",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Run Changesets",
        "description": "Run the shared Changesets toolchain."
      },
      {
        "id": "devtools.lint",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Run ESLint",
        "description": "Run the shared ESLint toolchain."
      },
      {
        "id": "devtools.format",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Run Prettier",
        "description": "Run the shared Prettier toolchain."
      },
      {
        "id": "devtools.knip",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Run Knip",
        "description": "Run the shared Knip toolchain."
      },
      {
        "id": "devtools.sync",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Sync repository",
        "description": "Synchronize all managed repository setup."
      },
      {
        "id": "devtools.status",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Check repository status",
        "description": "Report drift for all managed repository setup."
      },
      {
        "id": "devtools.agents.sync",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Sync agent instructions",
        "description": "Synchronize the canonical repository agent instructions."
      },
      {
        "id": "devtools.agents.status",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Check agent instructions",
        "description": "Report drift for the canonical repository agent instructions."
      },
      {
        "id": "devtools.skills.sync",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Sync agent skills",
        "description": "Synchronize canonical repository-local agent skills."
      },
      {
        "id": "devtools.skills.status",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Check agent skills",
        "description": "Report drift for canonical repository-local agent skills."
      },
      {
        "id": "devtools.eslint.sync",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Sync ESLint",
        "description": "Synchronize the shared ESLint setup."
      },
      {
        "id": "devtools.eslint.status",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Check ESLint",
        "description": "Report drift for the shared ESLint setup."
      },
      {
        "id": "devtools.prettier.sync",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Sync Prettier",
        "description": "Synchronize the shared Prettier setup."
      },
      {
        "id": "devtools.prettier.status",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Check Prettier",
        "description": "Report drift for the shared Prettier setup."
      },
      {
        "id": "devtools.knip.sync",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Sync Knip",
        "description": "Synchronize the shared Knip setup."
      },
      {
        "id": "devtools.knip.status",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Check Knip",
        "description": "Report drift for the shared Knip setup."
      },
      {
        "id": "devtools.package.sync",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Sync package metadata",
        "description": "Synchronize the shared package.json contract."
      },
      {
        "id": "devtools.package.status",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Check package metadata",
        "description": "Report drift for the shared package.json contract."
      },
      {
        "id": "devtools.workflows.sync",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Sync workflows",
        "description": "Synchronize the canonical GitHub Actions workflows."
      },
      {
        "id": "devtools.workflows.status",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Check workflows",
        "description": "Report drift for the canonical GitHub Actions workflows."
      },
      {
        "id": "devtools.vscode.sync",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Sync VS Code",
        "description": "Synchronize the canonical VS Code workspace configuration."
      },
      {
        "id": "devtools.vscode.status",
        "owner": "@ankhorage/devtools",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Check VS Code",
        "description": "Report drift for the canonical VS Code workspace configuration."
      }
    ]
  },
  "ankhorage": {
    "renovateSyncProtocol": 2
  },
  "keywords": [
    "ankhorage",
    "developer-tools",
    "eslint",
    "github-actions",
    "knip",
    "prettier",
    "repository-sync",
    "typescript",
    "vscode"
  ],
  "bin": {
    "ankhorage-changeset": "./dist/cli/bin/changeset.js",
    "ankhorage-eslint": "./dist/cli/bin/eslint.js",
    "ankhorage-knip": "./dist/cli/bin/knip.js",
    "ankhorage-prettier": "./dist/cli/bin/prettier.js",
    "ankhorage-apm-release": "./dist/cli/bin/apm-release.js",
    "ankhorage-structure": "./dist/cli/bin/structure.js"
  },
  "exports": {
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./eslint": {
      "types": "./dist/tools/eslint/index.d.ts",
      "import": "./dist/tools/eslint/index.js"
    },
    "./knip": {
      "types": "./dist/tools/knip/index.d.ts",
      "import": "./dist/tools/knip/index.js"
    },
    "./prettier": {
      "import": "./dist/tools/prettier/index.cjs",
      "require": "./dist/tools/prettier/index.cjs",
      "default": "./dist/tools/prettier/index.cjs"
    },
    "./apm-release": {
      "types": "./dist/apmRelease.d.ts",
      "import": "./dist/apmRelease.js"
    },
    "./types": {
      "types": "./dist/types/public.d.ts",
      "import": "./dist/types/public.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc && mkdir -p dist/tools/prettier dist/tools/workflows dist/tools/vscode dist/tools/skills && cp src/tools/prettier/index.cjs dist/tools/prettier/index.cjs && cp -R src/tools/workflows/files dist/tools/workflows/files && cp -R src/tools/vscode/files dist/tools/vscode/files && cp -R src/tools/skills/assets dist/tools/skills/assets",
    "typecheck": "bun run check-types",
    "doctor": "ankhorage-doctor validate .",
    "knip:check": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "paradox && bun run docs:check",
    "docs:check": "bun scripts/check-docs.ts",
    "test": "bun test",
    "changeset": "bun src/cli/bin/changeset.ts",
    "changeset:status": "bun src/cli/bin/changeset.ts status --since=origin/main",
    "version-packages": "bun src/cli/bin/changeset.ts version",
    "check-types": "bun x tsc --noEmit -p tsconfig.test.json",
    "test:standalone": "bun test src/tools/agents/index.test.ts src/features/managed-files/managedFiles.test.ts"
  },
  "dependencies": {
    "@ankhorage/apm": "^0.8.14",
    "@ankhorage/contracts": "^24.1.0",
    "@ankhorage/project-detector": "^0.3.4",
    "@ankhorage/rules-repository": "^0.2.0",
    "@ankhorage/utility": "^0.5.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "devDependencies": {
    "@ankhorage/paradox": "^0.2.28",
    "@ankhorage/ankh": "^0.12.0",
    "@ankhorage/doctor": "0.13.1",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "sharp": "^0.35.5"
  },
  "packageManager": "bun@1.4.2"
}
