/**
 * Repository configuration
 *
 * Loads the canonical Ankhorage Devtools-owner dependency-update policy from its default branch.
 * Canonical runtime policy literals are updated in ankhorage/policy.
 */
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['github>ankhorage/renovate:devtools-owner'],
  packageRules: [
    {
      description: 'Keep Utility image consumer on 0.5 until devtools#260 migrates its owner',
      matchDepNames: ['@ankhorage/utility'],
      allowedVersions: '<0.6.0',
    },
    {
      description: 'Defer TypeScript 7 until the Devtools ESLint parser supports its compiler API',
      matchDepNames: ['typescript'],
      allowedVersions: '<7.0.0',
    },
  ],
}
